{
  "mcpServers": {
    "github": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@anthropic/mcp-server-github@latest"
      ],
      "env": {
        "GITHUB_TOKEN": ""
      }
    },
    "linear": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@linear/mcp-server@latest"
      ],
      "env": {
        "LINEAR_API_KEY": ""
      }
    }
  }
}
